{
  "name": "legado-source-generator",
  "version": "1.0.1",
  "description": "Legado Source Generator - 书源规则生成浏览器扩展",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:chrome": "cross-env BUILD_TARGET=chrome vite build && cross-env BUILD_TARGET=chrome node scripts/build-scripts.mjs",
    "build:firefox": "cross-env BUILD_TARGET=firefox vite build && cross-env BUILD_TARGET=firefox node scripts/build-scripts.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/chrome": "^0.0.258",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.10",
    "jsdom": "^24.0.0",
    "pkg-types": "^2.3.1",
    "playwright": "^1.41.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}